{
  "name": "tokrec-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/cli src/bin.ts",
    "build": "bun run --cwd packages/tokrec build && bun run --cwd packages/cli build",
    "typecheck": "bun run --cwd packages/tokrec typecheck && bun run --cwd packages/cli typecheck",
    "test": "bun test",
    "lint": "biome check packages/",
    "lint:fix": "biome check --write packages/",
    "format": "biome format --write packages/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "latest",
    "lefthook": "^2.1.9",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
